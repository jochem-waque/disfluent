  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@favware/npm-deprecate": "^2.0.0",
    "@tsconfig/node26": "^26.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/eslint-config-prettier": "^6.11.3",
